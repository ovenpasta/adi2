with "vendor/plutosvg/plutosvg.gpr";
with "vendor/rlottie/rlottie.gpr";

project Adi is

   type Build_Profile_Kind is ("release", "validation", "development");
   Build_Profile : Build_Profile_Kind := external ("ADI_BUILD_PROFILE", "development");
   Crate_Version := external ("ADI_LIBRARY_VERSION", "0.1.0-dev");
   User_Ada_Compiler_Switches := External_As_List ("ADAFLAGS", " ");
   Platform_Name := external ("ADI_PLATFORM", "linux");

   for Library_Name use "Adi";
   for Library_Version use Project'Library_Name & ".so." & Crate_Version;

   --  MCP introspection: full implementation in development, no-op stub otherwise
   MCP_Source_Dir := "";
   case Build_Profile is
      when "development" => MCP_Source_Dir := "src/mcp";
      when others        => MCP_Source_Dir := "src/mcp_stub";
   end case;
   --  Real MCP imports POSIX kill (src/mcp/adi-mcp.adb) and cannot link on
   --  Windows; force the stub there regardless of profile.
   case Platform_Name is
      when "windows" => MCP_Source_Dir := "src/mcp_stub";
      when others    => null;
   end case;

   Profile_Config_Dir := "";
   case Build_Profile is
      when "development" => Profile_Config_Dir := "config/development";
      when "release"     => Profile_Config_Dir := "config/release";
      when "validation"  => Profile_Config_Dir := "config/validation";
   end case;

   Target_Config_Dir := "config/posix";
   case Platform_Name is
      when "windows" => Target_Config_Dir := "config/windows";
      when "darwin"  => Target_Config_Dir := "config/darwin";
      when others    => Target_Config_Dir := "config/posix";
   end case;

   --  SVG rendering goes through the vendored plutosvg backend.
   for Source_Dirs use
     ("src/",
      "src/svg",
      "src/svg/plutosvg",
      Target_Config_Dir,
      Profile_Config_Dir,
      "vendor/json-ada/src",
      MCP_Source_Dir);
   for Object_Dir use "obj/" & Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/" & Build_Profile;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ADI_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   Profile_Ada_Compiler_Switches := ();
   case Build_Profile is
      when "release" =>
         Profile_Ada_Compiler_Switches := ("-O2", "-gnatn");
      when "validation" =>
         Profile_Ada_Compiler_Switches := ("-O2", "-g", "-gnata");
      when "development" =>
         Profile_Ada_Compiler_Switches := ("-Og", "-g", "-gnatwa", "-gnatw.X", "-gnatVa", "-gnatW8");
   end case;
   Ada_Switches := ("-gnat2022", "-gnatX0", "-gnatef");
   package Compiler is
      for Default_Switches ("Ada") use
        Profile_Ada_Compiler_Switches & User_Ada_Compiler_Switches & Ada_Switches;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  Native libraries the Adi library depends on, exported as
   --  Linker_Options: gprbuild collects these from the project closure,
   --  so any executable project that withs adi.gpr links them without
   --  repeating the switches.
   Default_SDL_Linker_Switches := ("-lSDL3", "-lSDL3_ttf", "-lSDL3_image", "-lm");

   --  On macOS:
   --    * GNAT FSF g++ was built expecting MacOSX14.sdk; with no such SDK
   --      present the linker fails to find -lSystem. Pass -Wl,-syslibroot
   --      pointing at the current CommandLineTools SDK (or an override
   --      from $MACOS_SDKROOT).
   --    * SDL3 is installed via Homebrew at /opt/homebrew/lib, which is
   --      not on the default linker search path. Add it plus an rpath so
   --      the binaries also locate the dylibs at runtime.
   Macos_SDK_Root := external
     ("MACOS_SDKROOT", "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk");
   Platform_Linker_Switches := ();
   case Platform_Name is
      when "darwin" =>
         Platform_Linker_Switches :=
           ("-Wl,-syslibroot," & Macos_SDK_Root,
            "-L/opt/homebrew/lib",
            "-Wl,-rpath,/opt/homebrew/lib",
            --  Vendor C/C++ is compiled with Apple clang against libc++,
            --  but GNAT g++ defaults to libstdc++. Pull in libc++ so the
            --  C++ runtime symbols resolve.
            "-lc++");
      when others =>
         null;
   end case;

   package Linker is
      for Linker_Options use
        Platform_Linker_Switches & Default_SDL_Linker_Switches;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adi;
