with "vendor/plutosvg/plutosvg.gpr";
with "vendor/rlottie/rlottie.gpr";

project Adi is

   type Build_Profile_Kind is ("release", "validation", "development");
   Build_Profile : Build_Profile_Kind := external ("ADI_BUILD_PROFILE", "development");
   type SVG_Backend_Kind is ("ada", "plutosvg");
   SVG_Backend : SVG_Backend_Kind := external ("ADI_SVG_BACKEND", "plutosvg");
   Crate_Version := external ("ADI_LIBRARY_VERSION", "0.1.0-dev");
   User_Ada_Compiler_Switches := External_As_List ("ADAFLAGS", " ");
   Platform_Name := external ("ADI_PLATFORM", "linux");

   for Library_Name use "Adi";
   for Library_Version use Project'Library_Name & ".so." & Crate_Version;

   case Platform_Name is
      when "windows" =>
         case SVG_Backend is
            when "ada" =>
               for Source_Dirs use
                 ("src/",
                  "src/svg",
                  "src/svg/ada",
                  "config/windows");
            when "plutosvg" =>
               for Source_Dirs use
                 ("src/",
                  "src/svg",
                  "src/svg/plutosvg",
                  "config/windows");
         end case;
      when others =>
         case SVG_Backend is
            when "ada" =>
               for Source_Dirs use
                 ("src/",
                  "src/svg",
                  "src/svg/ada",
                  "config/posix");
            when "plutosvg" =>
               for Source_Dirs use
                 ("src/",
                  "src/svg",
                  "src/svg/plutosvg",
                  "config/posix");
         end case;
   end case;
   for Object_Dir use "obj/" & Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ADI_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   Profile_Ada_Compiler_Switches := ();
   case Build_Profile is
      when "release" =>
         Profile_Ada_Compiler_Switches := ("-O2", "-gnatn");
      when "validation" =>
         Profile_Ada_Compiler_Switches := ("-O2", "-g", "-gnata");
      when "development" =>
         Profile_Ada_Compiler_Switches := ("-Og", "-g", "-gnatwa", "-gnatw.X", "-gnatVa", "-gnatW8");
   end case;
   Ada_Switches := ("-gnat2022", "-gnatX0", "-gnatef");
   package Compiler is
      for Default_Switches ("Ada") use
        Profile_Ada_Compiler_Switches & User_Ada_Compiler_Switches & Ada_Switches;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adi;
