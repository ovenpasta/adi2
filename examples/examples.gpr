with "../adi.gpr";  -- Reference your main project

project Examples is
   type Example_Kind is ("label_example", "button_example", "transition_example", "text_input_example", "text_editor_example", "demo_flex", "demo_block", "stack_example", "list_box_example", "combo_box_example", "overflow_example", "grid_example", "dialog_example", "font_example", "runtime_css_example", "animated_image_example", "rlottie_example", "html_view_example", "material_demo", "image_example", "slider_example", "value_input_example", "assets_example", "gradient_example", "hello_example", "hello_raw_example", "svg_example");
   Kind : Example_Kind := external ("EXAMPLE_KIND", "label_example");
   Platform_Name := external ("ADI_PLATFORM", "linux");

   for Source_Dirs use (".", "generated");
   for Object_Dir use "obj/" & Kind;
   for Exec_Dir use "bin";
   for Main use (Kind & ".adb");

   Ada_Switches := ("-gnat2022", "-gnatX0", "-gnatef", "-g", "-gnatwa", "-gnata");
   --  See adi.gpr: a stored traceback needs these on 32-bit Windows.
   type Frame_Pointer_Kind is ("yes", "no");
   Frame_Pointer : Frame_Pointer_Kind :=
     external ("ADI_FRAME_POINTER", "yes");

   Frame_Pointer_Switches := ();
   case Frame_Pointer is
      when "yes" => Frame_Pointer_Switches := ("-fno-omit-frame-pointer");
      when "no"  => Frame_Pointer_Switches := ();
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Ada_Switches & Frame_Pointer_Switches;
   end Compiler;

   --  See adi.gpr: a 32-bit Windows build cannot store one.
   type Traceback_Kind is ("yes", "no");
   Traceback : Traceback_Kind := external ("ADI_TRACEBACK", "yes");

   Binder_Switches := ();
   case Traceback is
      when "yes" => Binder_Switches := ("-E");
      when "no"  => Binder_Switches := ();
   end case;

   package Binder is
      for Switches ("Ada") use Binder_Switches;
   end Binder;

   --  SDL and platform linker switches come transitively from
   --  adi.gpr, which exports them as Linker_Options.
end Examples;
