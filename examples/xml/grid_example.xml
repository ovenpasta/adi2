<?xml version="1.0" encoding="UTF-8"?>
<adi>
  <link rel="stylesheet" href="css/grid_example.css"/>

  <window title="Grid Layout Reference" width="617px" height="617px">
    <box id="Root" class="root">
      <label text="Grid Layout Reference" class="title"/>

      <!-- grid-template-columns -->
      <box class="section">
        <label text="grid-template-columns" class="caption"/>
        <label text="Track sizes across the row. repeat(N, size) expands to N tracks of that size."
               class="note"/>
        <box class="cases">
          <box class="case">
            <label text="repeat(3, 1fr)" class="case-label"/>
            <box class="demo cols-3fr">
              <label text="1" class="cell"/>
              <label text="2" class="cell"/>
              <label text="3" class="cell"/>
            </box>
          </box>
          <box class="case">
            <label text="120px 1fr" class="case-label"/>
            <box class="demo cols-px-fr">
              <label text="120px" class="cell warm"/>
              <label text="1fr" class="cell"/>
            </box>
          </box>
          <box class="case">
            <label text="auto 1fr" class="case-label"/>
            <box class="demo cols-auto">
              <label text="auto" class="cell alt"/>
              <label text="1fr" class="cell"/>
            </box>
          </box>
          <box class="case">
            <label text="1fr 2fr 1fr" class="case-label"/>
            <box class="demo cols-weight">
              <label text="1" class="cell"/>
              <label text="2" class="cell rose"/>
              <label text="1" class="cell"/>
            </box>
          </box>
        </box>
      </box>

      <!-- mixed track kinds -->
      <box class="section">
        <label text="mixed track kinds" class="caption"/>
        <label text="120px 2fr 0.5fr auto. The px track is fixed, auto takes its content, and what is left is split between the two fr tracks by factor."
               class="note"/>
        <box class="demo cols-mixed">
          <label text="120px" class="cell warm"/>
          <label text="2fr" class="cell"/>
          <label text="0.5fr" class="cell rose"/>
          <label text="auto" class="cell alt"/>
        </box>
      </box>

      <!-- spans and placement -->
      <box class="section">
        <label text="grid-column and grid-row" class="caption"/>
        <label text="Four columns, three rows. Items take a start line, a span, or both."
               class="note"/>
        <box class="demo board">
          <label text="1 / span 2" class="cell span-2col"/>
          <label text="col 3, 1 / span 2" class="cell rose span-2row"/>
          <label text="col 4, row 1" class="cell at-4-1"/>
          <label text="col 1, row 2" class="cell alt at-1-2"/>
          <label text="col 2, row 2" class="cell alt at-2-2"/>
          <label text="col 4, row 2" class="cell at-4-2"/>
          <label text="col 1, row 3" class="cell at-1-3"/>
          <label text="2 / span 3" class="cell warm span-3col"/>
        </box>
      </box>

      <!-- gap per axis -->
      <box class="section">
        <label text="row-gap and column-gap" class="caption"/>
        <label text="gap sets both axes; the longhands set one each and leave the other alone."
               class="note"/>
        <box class="cases">
          <box class="case">
            <label text="gap: 14px" class="case-label"/>
            <box class="demo gap-both">
              <label text="1" class="cell"/><label text="2" class="cell"/><label text="3" class="cell"/>
              <label text="4" class="cell"/><label text="5" class="cell"/><label text="6" class="cell"/>
            </box>
          </box>
          <box class="case">
            <label text="row-gap 20px, col 2px" class="case-label"/>
            <box class="demo gap-row">
              <label text="1" class="cell alt"/><label text="2" class="cell alt"/><label text="3" class="cell alt"/>
              <label text="4" class="cell alt"/><label text="5" class="cell alt"/><label text="6" class="cell alt"/>
            </box>
          </box>
          <box class="case">
            <label text="row-gap 2px, col 20px" class="case-label"/>
            <box class="demo gap-col">
              <label text="1" class="cell rose"/><label text="2" class="cell rose"/><label text="3" class="cell rose"/>
              <label text="4" class="cell rose"/><label text="5" class="cell rose"/><label text="6" class="cell rose"/>
            </box>
          </box>
        </box>
      </box>

      <!-- fr floors -->
      <box class="section">
        <label text="flexible tracks and their items' minimums" class="caption"/>
        <label text="Three 1fr tracks in a 300px grid. A bare Nfr is minmax(auto, Nfr), so a track never shrinks below its item's minimum: the first two hold their tracks open and the third takes what is left."
               class="note"/>
        <box class="demo floor-grid">
          <label text="min 150px" class="cell red floor-wide"/>
          <label text="min 90px" class="cell warm floor-medium"/>
          <label text="rest" class="cell alt floor-rest"/>
        </box>
      </box>

      <!-- overflow against the automatic minimum -->
      <box class="section">
        <label text="an item that clips does not hold its track open" class="caption"/>
        <label text="An item's automatic minimum is the room its content needs. An item that hides its overflow shows that content a piece at a time, so it asks for nothing and its 1fr track keeps its equal share. Same grid, same label, same width: only overflow differs."
               class="note"/>
        <box class="cases">
          <box class="case">
            <label text="overflow: visible" class="case-label"/>
            <box class="demo clip-grid">
              <label text="a wide label with no minimum" class="cell red wide"/>
              <label text="1fr" class="cell"/>
            </box>
          </box>
          <box class="case">
            <label text="overflow: hidden" class="case-label"/>
            <box class="demo clip-grid">
              <label text="a wide label with no minimum" class="cell alt wide clipped"/>
              <label text="1fr" class="cell"/>
            </box>
          </box>
        </box>
      </box>

      <!-- scrolling grid -->
      <box class="section">
        <label text="a grid that scrolls" class="caption"/>
        <label text="overflow-y on the grid container itself: rows past the fixed height scroll instead of growing it."
               class="note"/>
        <box class="demo scroll-grid">
          <label text="1" class="cell"/><label text="2" class="cell"/><label text="3" class="cell"/>
          <label text="4" class="cell alt"/><label text="5" class="cell alt"/><label text="6" class="cell alt"/>
          <label text="7" class="cell rose"/><label text="8" class="cell rose"/><label text="9" class="cell rose"/>
          <label text="10" class="cell warm"/><label text="11" class="cell warm"/><label text="12" class="cell warm"/>
          <label text="13" class="cell"/><label text="14" class="cell"/><label text="15" class="cell"/>
          <label text="16" class="cell alt"/><label text="17" class="cell alt"/><label text="18" class="cell alt"/>
          <label text="19" class="cell rose"/><label text="20" class="cell rose"/><label text="21" class="cell rose"/>
          <label text="22" class="cell warm"/><label text="23" class="cell warm"/><label text="24" class="cell warm"/>
        </box>
      </box>

      <!-- auto-placement -->
      <box class="section">
        <label text="auto-placement" class="caption"/>
        <label text="Items without a line follow a cursor through the grid and skip what is taken. The row-only item is placed first, in the first free column of row 3. The spans take the first cells that fit and the plain items flow around them. The column-only item comes last: the cursor is past column 2, so it moves to the next row, and down until column 2 is free."
               class="note"/>
        <box class="demo auto-board">
          <label text="span 2" class="cell auto-span-2col"/>
          <label text="row span 2" class="cell rose auto-span-2row"/>
          <label text="a" class="cell alt"/>
          <label text="b" class="cell alt"/>
          <label text="c" class="cell alt"/>
          <label text="d" class="cell alt"/>
          <label text="column 2" class="cell warm col-only-2"/>
          <label text="row 3" class="cell red row-only-3"/>
        </box>
      </box>

      <!-- row heights -->
      <box class="section">
        <label text="row heights" class="caption"/>
        <label text="A row is as tall as its tallest item: the long label wraps in its 1fr column and takes its neighbour with it. With a declared height and grid-template-rows: repeat(2, 1fr), the rows share that height instead."
               class="note"/>
        <box class="cases">
          <box class="case">
            <label text="from content" class="case-label"/>
            <box class="demo cols-2fr">
              <label text="a label long enough to wrap onto several lines" class="cell wrapping"/>
              <label text="2" class="cell alt"/>
              <label text="3" class="cell alt"/>
              <label text="4" class="cell alt"/>
            </box>
          </box>
          <box class="case">
            <label text="height: 160px, two rows" class="case-label"/>
            <box class="demo rows-shared">
              <label text="1" class="cell"/>
              <label text="2" class="cell"/>
              <label text="3" class="cell rose"/>
              <label text="4" class="cell rose"/>
            </box>
          </box>
        </box>
      </box>

      <!-- a column count -->
      <box class="section">
        <label text="a column count" class="caption"/>
        <label text="grid-template-columns: 3 asks for three equal columns without naming their sizes; five items fill one row and part of the next."
               class="note"/>
        <box class="demo cols-count">
          <label text="1" class="cell"/><label text="2" class="cell"/><label text="3" class="cell"/>
          <label text="4" class="cell warm"/><label text="5" class="cell warm"/>
        </box>
      </box>

      <!-- nesting -->
      <box class="section">
        <label text="nesting" class="caption"/>
        <label text="A cell can be a flex row or another grid."
               class="note"/>
        <box class="demo cols-2fr">
          <box class="cell nested-row">
            <label text="flex" class="cell alt"/>
            <label text="in a cell" class="cell alt"/>
          </box>
          <box class="demo cols-2fr nested-grid">
            <label text="grid" class="cell rose"/>
            <label text="in a cell" class="cell rose"/>
          </box>
        </box>
      </box>
    </box>
  </window>
</adi>
