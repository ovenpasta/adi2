with "../adi.gpr";  -- Reference your main project

project Tests is
   type Test_Kind is
     ("styles",
      "layout_test",
      "layout_flex_grid_test",
      "css_parser_test",
      "css_source_test",
      "text_buffer_test",
      "text_layout_test");
   Kind : Test_Kind := external ("TEST_KIND", "styles");

   for Source_Dirs use ("src");
   for Object_Dir use "obj/"&Kind;
   for Exec_Dir use "bin";
   for Main use (Kind & ".adb");

   Ada_Switches := ("-gnat2022", "-gnatX0","-gnatef","-g", "-gnatwa", "-gnata");
   package Compiler is
      for Default_Switches ("Ada") use Ada_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-E");  -- Store exception traceback
    end Binder;

   Default_SDL_Linker_Switches := ("-lSDL3", "-lSDL3_ttf", "-lSDL3_image", "-lm");
   Pkg_Config_SDL_Linker_Switches := External_As_List ("ADI_SDL_LINKER_FLAGS", " ");
   Platform_Linker_Switches := External_As_List ("ADI_PLATFORM_LINKER_FLAGS", " ");

   package Linker is
      for Default_Switches ("Ada") use
        Default_SDL_Linker_Switches &
        Pkg_Config_SDL_Linker_Switches &
        Platform_Linker_Switches;
   end Linker;
end Tests;
