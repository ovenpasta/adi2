with "../adi.gpr";  -- Reference your main project

project Tests is
   type Test_Kind is
     ("styles",
      "layout_test",
      "layout_flex_grid_test",
      "flex_wrap_test",
      "flex_justify_test",
      "css_parser_test",
      "window_extent_test",
      "css_source_test",
      "text_buffer_test",
      "text_layout_test",
      "text_overflow_test",
      "html_view_test",
      "html_view_snapshot_test",
      "svg_test",
      "svg_perf_test",
      "disabled_test",
      "image_widget_test",
      "slider_test",
      "value_input_test",
      "svg_sprites_test",
      "min_size_test",
      "layout_perf_test",
      "style_storage_equivalence_test",
      "window_resize_safety_test",
      "mcp_test",
      "bundle_test",
      "signal_test",
      "dispatch_test",
      "i18n_test",
      "settings_test",
      "close_request_test",
      "window_handle_test",
      "text_editor_test",
      "handle_store_test",
      "widget_handle_test",
      "combo_box_item_test",
      "dialog_test",
      "text_input_test",
      "font_test",
      "scroll_primitives_test",
      "label_wrap_test",
      "clock_test",
      "shadow_test",
      "shadow_slice_test");
   Kind : Test_Kind := external ("TEST_KIND", "styles");
   Platform_Name := external ("ADI_PLATFORM", "linux");

   for Source_Dirs use ("src");
   for Object_Dir use "obj/"&Kind;
   for Exec_Dir use "bin";
   for Main use (Kind & ".adb");

   Ada_Switches :=
     ("-gnat2022", "-gnatX0", "-gnatef", "-g", "-gnatwa", "-gnata", "-gnatW8");
   package Compiler is
      for Default_Switches ("Ada") use Ada_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-E");  -- Store exception traceback
    end Binder;

   --  SDL and platform linker switches come transitively from
   --  adi.gpr, which exports them as Linker_Options.
end Tests;
