with "../adi.gpr";  -- Reference your main project

project Tests is
   type Test_Kind is
     ("styles",
      "layout_test",
      "layout_flex_grid_test",
      "css_parser_test",
      "css_source_test",
      "text_buffer_test",
      "text_layout_test",
      "html_view_test",
      "svg_test",
      "svg_perf_test",
      "disabled_test",
      "image_widget_test",
      "slider_test",
      "value_input_test",
      "svg_sprites_test",
      "min_size_test",
      "layout_perf_test",
      "style_storage_equivalence_test",
      "window_resize_safety_test",
      "mcp_test",
      "bundle_test",
      "signal_test",
      "dispatch_test",
      "i18n_test",
      "settings_test",
      "close_request_test",
      "window_handle_test",
      "text_editor_test",
      "handle_store_test",
      "widget_handle_test",
      "combo_box_item_test",
      "dialog_test",
      "text_input_test",
      "font_test",
      "scroll_primitives_test");
   Kind : Test_Kind := external ("TEST_KIND", "styles");
   Platform_Name := external ("ADI_PLATFORM", "linux");

   for Source_Dirs use ("src");
   for Object_Dir use "obj/"&Kind;
   for Exec_Dir use "bin";
   for Main use (Kind & ".adb");

   Ada_Switches :=
     ("-gnat2022", "-gnatX0", "-gnatef", "-g", "-gnatwa", "-gnata", "-gnatW8");
   package Compiler is
      for Default_Switches ("Ada") use Ada_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-E");  -- Store exception traceback
    end Binder;

   Default_SDL_Linker_Switches := ("-lSDL3", "-lSDL3_ttf", "-lSDL3_image", "-lm");

   --  On macOS:
   --    * GNAT FSF g++ was built expecting MacOSX14.sdk; with no such SDK
   --      present the linker fails to find -lSystem. Pass -Wl,-syslibroot
   --      pointing at the current CommandLineTools SDK (or an override
   --      from $MACOS_SDKROOT).
   --    * SDL3 is installed via Homebrew at /opt/homebrew/lib, which is
   --      not on the default linker search path. Add it plus an rpath so
   --      the binaries also locate the dylibs at runtime.
   Macos_SDK_Root := external
     ("MACOS_SDKROOT", "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk");
   Platform_Linker_Switches := ();
   case Platform_Name is
      when "darwin" =>
         Platform_Linker_Switches :=
           ("-Wl,-syslibroot," & Macos_SDK_Root,
            "-L/opt/homebrew/lib",
            "-Wl,-rpath,/opt/homebrew/lib",
            --  Vendor C/C++ is compiled with Apple clang against libc++,
            --  but GNAT g++ defaults to libstdc++. Pull in libc++ so the
            --  C++ runtime symbols resolve.
            "-lc++");
      when others =>
         null;
   end case;

   package Linker is
      for Default_Switches ("Ada") use
        Platform_Linker_Switches & Default_SDL_Linker_Switches;
   end Linker;
end Tests;
