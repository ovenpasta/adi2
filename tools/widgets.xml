<?xml version="1.0" encoding="UTF-8"?>
<!--
  Widget grammar for xml_to_ada.py

  Each <widget> defines how a tag in the input XML maps to Ada code:
    tag            - XML element name
    generic        - "true" if access type resolves via generic instance
    children-mode  - "pages" for Add_Page wiring, default is Add_Child

  Sub-elements:
    <package>      - Ada package name
    <access-type>  - Ada access type (short name, qualified automatically)
    <handle-type>  - Ada handle type (short name, qualified automatically)
    <create>       - Template for Create expression ({package}, {text}, etc.)
    <create-handle>- Template for Create_Handle expression
    <attribute>    - Widget-specific attribute from input XML
      name         - XML attribute name
      type         - "string", "bool", or "callback"
      create-param - "true" if used in the <create> template
      default      - Default value for create-param bools
      setter       - Ada setter procedure name
      setter-style - "flag" means call with no arguments
      meta         - "true" means script-internal, not emitted as Ada
-->
<widgets>

  <widget tag="box">
    <package>Adi.Widget.Box</package>
    <access-type>Box_Widget_Access</access-type>
    <handle-type>Box_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
  </widget>

  <widget tag="label">
    <package>Adi.Widget.Label</package>
    <access-type>Label_Widget_Access</access-type>
    <handle-type>Label_Handle</handle-type>
    <create>{package}.Create ("{text}")</create>
    <create-handle>{package}.Create_Handle ("{text}")</create-handle>
    <attribute name="text" type="string" create-param="true" translatable="true"/>
    <attribute name="icon" type="image" setter="Set_Icon"/>
  </widget>

  <widget tag="button">
    <package>Adi.Widget.Button</package>
    <access-type>Button_Widget_Access</access-type>
    <handle-type>Button_Handle</handle-type>
    <create>{package}.Create ("{text}")</create>
    <create-handle>{package}.Create_Handle ("{text}")</create-handle>
    <attribute name="text" type="string" create-param="true" translatable="true"/>
    <attribute name="icon" type="image" setter="Set_Icon"/>
    <attribute name="toggleable" type="bool" setter="Set_Toggleable" setter-style="flag"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-clicked" type="callback" setter="Connect_Clicked"/>
    <attribute name="on-toggled" type="callback" setter="Connect_Toggled"/>
  </widget>

  <widget tag="switch">
    <package>Adi.Widget.Button.Switch</package>
    <access-type>Switch_Widget_Access</access-type>
    <handle-type>Switch_Handle</handle-type>
    <create>{package}.Create ({checked})</create>
    <create-handle>{package}.Create_Handle ({checked})</create-handle>
    <attribute name="checked" type="bool" create-param="true" default="False"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-toggled" type="callback" setter="Connect_Toggled"/>
  </widget>

  <widget tag="stack" generic="true" children-mode="pages">
    <package>Adi.Widget.Stack</package>
    <access-type>Stack_Widget_Access</access-type>
    <handle-type>Stack_Handle</handle-type>
    <create>{generic_name}.Create</create>
    <create-handle>{generic_name}.Create_Handle</create-handle>
    <attribute name="generic" type="string" required="true" meta="true"/>
    <attribute name="on-changed" type="callback" setter="Connect_Changed"/>
  </widget>

  <widget tag="text-input">
    <package>Adi.Widget.Text_Input</package>
    <access-type>Text_Input_Widget_Access</access-type>
    <handle-type>Text_Input_Handle</handle-type>
    <create>{package}.Create ("{text}")</create>
    <create-handle>{package}.Create_Handle ("{text}")</create-handle>
    <attribute name="text" type="string" create-param="true" translatable="true"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-changed" type="callback" setter="Connect_Changed"/>
  </widget>

  <widget tag="text-editor">
    <package>Adi.Widget.Text_Editor</package>
    <access-type>Text_Editor_Widget_Access</access-type>
    <handle-type>Text_Editor_Handle</handle-type>
    <create>{package}.Create ("{text}")</create>
    <create-handle>{package}.Create_Handle ("{text}")</create-handle>
    <attribute name="text" type="string" create-param="true" translatable="true"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-changed" type="callback" setter="Connect_Changed"/>
  </widget>

  <widget tag="combo-box" children-mode="items">
    <package>Adi.Widget.Combo_Box</package>
    <access-type>Combo_Box_Widget_Access</access-type>
    <handle-type>Combo_Box_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-selection-changed" type="callback" setter="Connect_Selection_Changed"/>
  </widget>

  <widget tag="image">
    <package>Adi.Widget.Image</package>
    <access-type>Image_Widget_Access</access-type>
    <handle-type>Image_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
    <attribute name="src" type="image" setter="Set_Image"/>
  </widget>

  <widget tag="animated-image">
    <package>Adi.Widget.Animated_Image</package>
    <access-type>Animated_Image_Widget_Access</access-type>
    <handle-type>Animated_Image_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
    <attribute name="looping" type="bool" setter="Set_Looping" setter-style="flag"/>
  </widget>

  <widget tag="animated-widget">
    <package>Adi.Widget.Animated_Widget</package>
    <access-type>Animated_Widget_Access</access-type>
    <handle-type>Animated_Widget_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
    <attribute name="looping" type="bool" setter="Set_Looping" setter-style="flag"/>
  </widget>

  <widget tag="rlottie">
    <package>Adi.Widget.RLottie</package>
    <access-type>RLottie_Widget_Access</access-type>
    <handle-type>RLottie_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
    <attribute name="looping" type="bool" setter="Set_Looping" setter-style="flag"/>
  </widget>

  <widget tag="html-view">
    <package>Adi.Widget.Html_View</package>
    <access-type>Html_View_Access</access-type>
    <handle-type>Html_View_Handle</handle-type>
    <create>{package}.Create</create>
    <create-handle>{package}.Create_Handle</create-handle>
  </widget>

  <widget tag="list-box" generic="true" children-mode="rows">
    <package>Adi.Widget.List_Box</package>
    <access-type>List_Box_Widget_Access</access-type>
    <handle-type>List_Box_Handle</handle-type>
    <create>{generic_name}.Create</create>
    <create-handle>{generic_name}.Create_Handle</create-handle>
    <attribute name="generic" type="string" required="true" meta="true"/>
    <attribute name="on-item-clicked" type="callback" setter="Connect_Item_Clicked"/>
    <attribute name="on-item-activated" type="callback" setter="Connect_Item_Activated"/>
    <attribute name="on-selection-changed" type="callback" setter="Connect_Selection_Changed"/>
  </widget>

  <widget tag="slider" generic="true">
    <package>Adi.Widget.Slider</package>
    <access-type>Slider_Widget_Access</access-type>
    <handle-type>Slider_Handle</handle-type>
    <create>{generic_name}.Create (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create>
    <create-handle>{generic_name}.Create_Handle (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create-handle>
    <attribute name="generic" type="string" required="true" meta="true"/>
    <attribute name="min" type="string" create-param="true"/>
    <attribute name="max" type="string" create-param="true"/>
    <attribute name="value" type="string" create-param="true"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-changed" type="callback" setter="Connect_Changed"/>
  </widget>

  <widget tag="integer-slider" generic="true">
    <package>Adi.Widget.Integer_Slider</package>
    <access-type>Slider_Widget_Access</access-type>
    <handle-type>Slider_Handle</handle-type>
    <create>{generic_name}.Create (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create>
    <create-handle>{generic_name}.Create_Handle (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create-handle>
    <attribute name="generic" type="string" required="true" meta="true"/>
    <attribute name="min" type="string" create-param="true"/>
    <attribute name="max" type="string" create-param="true"/>
    <attribute name="value" type="string" create-param="true"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-changed" type="callback" setter="Connect_Changed"/>
  </widget>

  <widget tag="value-input" generic="true">
    <package>Adi.Widget.Value_Input</package>
    <access-type>Value_Input_Widget_Access</access-type>
    <handle-type>Value_Input_Handle</handle-type>
    <create>{generic_name}.Create (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create>
    <create-handle>{generic_name}.Create_Handle (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create-handle>
    <attribute name="generic" type="string" required="true" meta="true"/>
    <attribute name="min" type="string" create-param="true"/>
    <attribute name="max" type="string" create-param="true"/>
    <attribute name="value" type="string" create-param="true"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-value-changed" type="callback" setter="Connect_Value_Changed"/>
  </widget>

  <widget tag="integer-value-input" generic="true">
    <package>Adi.Widget.Integer_Value_Input</package>
    <access-type>Value_Input_Widget_Access</access-type>
    <handle-type>Value_Input_Handle</handle-type>
    <create>{generic_name}.Create (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create>
    <create-handle>{generic_name}.Create_Handle (Min =&gt; {min}, Max =&gt; {max}, Value =&gt; {value})</create-handle>
    <attribute name="generic" type="string" required="true" meta="true"/>
    <attribute name="min" type="string" create-param="true"/>
    <attribute name="max" type="string" create-param="true"/>
    <attribute name="value" type="string" create-param="true"/>
    <attribute name="disabled" type="bool" setter="Set_Disabled" setter-style="flag"/>
    <attribute name="on-value-changed" type="callback" setter="Connect_Value_Changed"/>
  </widget>

</widgets>
