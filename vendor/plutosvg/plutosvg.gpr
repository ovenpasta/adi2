project PlutoSVG is

   type Build_Profile_Kind is ("release", "validation", "development");
   Build_Profile : Build_Profile_Kind := external ("ADI_BUILD_PROFILE", "development");
   Platform_Name := external ("ADI_PLATFORM", "linux");
   User_C_Compiler_Switches := External_As_List ("CFLAGS", " ");

   for Languages use ("C");
   for Source_Dirs use ("source", "plutovg/source", "plutovg/include");
   for Object_Dir use "obj/" & Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Name use "plutosvg";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ADI_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   Profile_C_Compiler_Switches := ();
   case Build_Profile is
      when "release" =>
         Profile_C_Compiler_Switches := ("-O2");
      when "validation" =>
         Profile_C_Compiler_Switches := ("-O2", "-g");
      when "development" =>
         Profile_C_Compiler_Switches := ("-Og", "-g");
   end case;

   C_Switches :=
     ("-std=c99",
      "-DPLUTOVG_BUILD",
      "-DPLUTOVG_BUILD_STATIC",
      "-DPLUTOSVG_BUILD",
      "-DPLUTOSVG_BUILD_STATIC");

   --  On macOS we drive C through Apple clang. clang ignores gprbuild's
   --  GCC-style -specs= include-path injection, so mirror Source_Dirs as
   --  explicit -I flags.
   Platform_C_Switches := ();
   case Platform_Name is
      when "darwin" =>
         Platform_C_Switches :=
           ("-mmacosx-version-min=11.0",
            "-I" & Project'Project_Dir & "source",
            "-I" & Project'Project_Dir & "plutovg/source",
            "-I" & Project'Project_Dir & "plutovg/include");
      when others =>
         null;
   end case;

   package Compiler is
      case Platform_Name is
         when "darwin" =>
            --  See rlottie.gpr: use Apple clang to bypass GNAT FSF's stale
            --  fixincludes headers under macOS 15+ SDKs.
            for Driver ("C") use "/usr/bin/clang";
         when others =>
            null;
      end case;
      for Default_Switches ("C") use
        Profile_C_Compiler_Switches & User_C_Compiler_Switches
        & C_Switches & Platform_C_Switches;
   end Compiler;

end PlutoSVG;
